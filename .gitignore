# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Build artifacts
dist/
build/
# Exception: the canonical-build python module lives at src/frontprompt/build/
# — it is real source code, not a build artifact.
!src/frontprompt/build/
*.egg-info/

# Coverage
.coverage
htmlcov/
coverage.xml

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# uv.lock is committed (reproducible CI builds)

# Frontend (Bun/Vite)
frontend/node_modules/
frontend/.svelte-kit/
frontend/dist/
# Auto-generated by `python -m frontprompt.build` — never hand-edit
frontend/src/_generated/
# Overlay bundle embedded into the package by `python -m frontprompt.build`.
# A built artifact (~1.7MB) — NOT committed, but `uv_build` still ships it in
# the wheel (it globs the module dir on disk, ignoring .gitignore). Rebuild via
# `python -m frontprompt.build`; package via `--wheel`.
src/frontprompt/_overlay/

# site (marketing + docs)
site/node_modules/
site/dist/
